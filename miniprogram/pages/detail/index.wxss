page {
  background: #f3f5f8;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
}

.gallery {
  width: 100%;
  height: 460rpx;
}

.gallery-item {
  position: relative;
  width: 100%;
  height: 460rpx;
}

.hero-image {
  width: 100%;
  height: 460rpx;
  border-radius: 28rpx;
  background: #d9e2ec;
  box-shadow: 0 20rpx 50rpx rgba(20, 33, 61, 0.12);
}

.detail-card {
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 44rpx rgba(20, 33, 61, 0.08);
}

.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #14213d;
  margin-bottom: 24rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 26rpx;
  color: #64748b;
}

.detail-value {
  max-width: 420rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
}

.accent {
  color: #d97706;
}

.edit-fab,
.delete-fab {
  position: fixed;
  bottom: 40rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-fab {
  left: 32rpx;
  background: #2563eb;
  box-shadow: 0 14rpx 34rpx rgba(37, 99, 235, 0.3);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.delete-fab {
  right: 32rpx;
  background: #f02828;
  box-shadow: 0 14rpx 34rpx rgba(240, 40, 40, 0.34);
}

.trash-icon {
  position: relative;
  width: 44rpx;
  height: 46rpx;
}

.trash-top {
  position: absolute;
  left: 14rpx;
  top: 0;
  width: 16rpx;
  height: 6rpx;
  border: 4rpx solid #ffffff;
  border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
  box-sizing: border-box;
}

.trash-lid {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 44rpx;
  height: 4rpx;
  background: #ffffff;
  border-radius: 4rpx;
}

.trash-can {
  position: absolute;
  left: 8rpx;
  top: 14rpx;
  width: 28rpx;
  height: 26rpx;
  border: 4rpx solid #ffffff;
  border-top: none;
  border-radius: 0 0 8rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-evenly;
  box-sizing: border-box;
}

.trash-line {
  width: 3rpx;
  height: 14rpx;
  background: #ffffff;
  border-radius: 3rpx;
}