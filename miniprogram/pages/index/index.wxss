page {
  background: #f3f5f8;
  color: #1f2937;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 200rpx;
  box-sizing: border-box;
}

.section {
  min-height: calc(100vh - 220rpx);
}

.page-title {
  margin-bottom: 26rpx;
  padding-left: 4rpx;
  font-size: 50rpx;
  font-weight: 700;
  color: #14213d;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.search-input {
  flex: 1;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(20, 33, 61, 0.06);
  font-size: 26rpx;
  color: #0f172a;
  box-sizing: border-box;
}

.search-clear {
  flex-shrink: 0;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: #eef2f7;
  color: #475569;
  font-size: 22rpx;
}

.filter-shell {
  position: relative;
  z-index: 50;
  min-height: 64rpx;
  padding: 0 4rpx;
}

.panel-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.panel-group {
  position: relative;
}

.panel-half {
  flex: 1;
}

.panel-active {
  z-index: 60;
}

.expand-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 52rpx;
}

.expand-title {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 600;
}

.expand-arrow {
  font-size: 28rpx;
  color: #94a3b8;
  transform: rotate(0deg);
  transition: transform 0.2s ease;
}

.expand-arrow-open {
  transform: rotate(180deg);
}

.expand-overlay {
  position: absolute;
  top: 60rpx;
  left: 0;
  right: 0;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(243, 245, 248, 0.98);
  box-shadow: 0 14rpx 34rpx rgba(20, 33, 61, 0.08);
}

.category-label {
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.category-space {
  margin-bottom: 18rpx;
}

.sort-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.sort-chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #64748b;
  font-size: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(20, 33, 61, 0.06);
}

.sort-chip-active {
  background: #14213d;
  color: #ffffff;
}

.hero {
  margin-bottom: 28rpx;
  padding: 32rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #eef4ff 100%);
  box-shadow: 0 16rpx 40rpx rgba(38, 74, 118, 0.08);
}

.add-hero {
  background: linear-gradient(135deg, #fff7ed 0%, #ffffff 100%);
}

.profile-hero {
  background: linear-gradient(135deg, #ecfeff 0%, #ffffff 100%);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #14213d;
}

.hero-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5b6472;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 20rpx 0;
  margin-top: 24rpx;
  position: relative;
  z-index: 1;
}

.card {
  position: relative;
  width: 342rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(20, 33, 61, 0.08);
}

.card-image {
  width: 100%;
  height: 240rpx;
  background: #d9e2ec;
}

.card-body {
  padding: 22rpx;
}

.car-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #14213d;
  margin-bottom: 14rpx;
}

.car-meta,
.car-price {
  font-size: 24rpx;
  line-height: 1.7;
  color: #5b6472;
}

.car-price {
  color: #d97706;
  font-weight: 600;
}

.car-model-brand {
  margin-bottom: 10rpx;
  color: #243b63;
  font-weight: 700;
}

.empty {
  margin-top: 80rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8a94a6;
}

.static-panel,
.profile-card {
  padding: 32rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(20, 33, 61, 0.08);
}

.form-item {
  margin-bottom: 18rpx;
}

.form-label {
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: #475569;
}

.image-upload,
.form-input,
.form-picker,
.nickname-input {
  width: 100%;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
}

.image-upload {
  padding: 28rpx 24rpx;
  box-sizing: border-box;
}

.upload-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #14213d;
}

.upload-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
}

.thumb-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}

.thumb-item {
  position: relative;
  width: 146rpx;
  height: 146rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #e2e8f0;
}

.thumb-image {
  width: 100%;
  height: 100%;
}

.thumb-remove {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  background: rgba(15, 23, 42, 0.72);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1;
}

.form-input,
.form-picker,
.nickname-input {
  box-sizing: border-box;
  min-height: 84rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #0f172a;
  display: flex;
  align-items: center;
}

.form-picker {
  color: #94a3b8;
}

.form-picker.filled {
  color: #0f172a;
}

.primary-button,
.ghost-button,
.avatar-button {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  margin: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.primary-button {
  background: #14213d;
  color: #ffffff;
}

.ghost-button {
  background: #eef2f7;
  color: #475569;
}

.primary-button::after,
.ghost-button::after,
.avatar-button::after {
  border: none;
}

.full-button {
  margin-top: 28rpx;
  height: 84rpx;
}

.login-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.login-status {
  font-size: 28rpx;
  font-weight: 700;
  color: #14213d;
}

.profile-editor {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 8rpx;
  margin-bottom: 6rpx;
}

.avatar-button {
  width: 112rpx;
  height: 112rpx;
  padding: 0;
  border-radius: 56rpx;
  background: #eef2f7;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 24rpx;
}

.nickname-input {
  flex: 1;
}

.login-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.profile-button {
  flex: 1;
  height: 80rpx;
}

.profile-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #14213d;
  margin-bottom: 4rpx;
}

.profile-text {
  font-size: 25rpx;
  line-height: 1.8;
  color: #5b6472;
  word-break: break-all;
}

.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 9999;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.18);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #94a3b8;
}

.tab-item-active {
  color: #14213d;
}

.tab-item-center {
  margin-top: -36rpx;
}

.plus-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #14213d;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  line-height: 1;
  box-shadow: 0 14rpx 32rpx rgba(20, 33, 61, 0.24);
}

.tab-text {
  font-size: 22rpx;
  font-weight: 600;
}

.form-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #94a3b8;
}
.tag-toggle {
  display: inline-flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #eef2f7;
  color: #475569;
  font-size: 22rpx;
  font-weight: 600;
}
.tag-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.tag-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #e8eefc;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 600;
}
.tag-chip-active {
  background: #14213d;
  color: #ffffff;
}

.form-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  font-size: 26rpx;
  color: #0f172a;
  line-height: 1.7;
}
