<view class="image-manager">
  <view class="image-manager-head">
    <view class="image-manager-title">{{title}}</view>
    <view class="image-count">已上传 {{totalCount}}/{{maxCount}} 张</view>
  </view>

  <view class="image-add {{uploading || choosing ? 'image-add-disabled' : ''}}" bindtap="chooseImages">
    <view class="image-add-plus">+</view>
    <view>
      <view class="image-add-title">添加图片</view>
      <view class="image-add-tip">支持从相册选择或直接拍照，上传前自动压缩</view>
    </view>
  </view>

  <view class="loading-tip" wx:if="{{loading}}">正在读取云端图片...</view>
  <view class="error-tip" wx:if="{{loadError}}" bindtap="loadImages">{{loadError}}，点击重试</view>

  <view class="thumb-list" wx:if="{{items.length}}">
    <view class="thumb-item" wx:for="{{items}}" wx:key="key">
      <image class="thumb-image" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="previewImage"></image>
      <view class="thumb-remove" wx:if="{{item.status === 'ready'}}" data-key="{{item.key}}" catchtap="removeImage">×</view>
      <view class="upload-mask" wx:if="{{item.status === 'compressing' || item.status === 'uploading'}}">
        <view class="upload-status">{{item.statusText}}</view>
        <view class="progress-track"><view class="progress-value" style="width: {{item.progress}}%;"></view></view>
      </view>
      <view class="upload-mask upload-failed" wx:if="{{item.status === 'failed'}}" data-key="{{item.key}}" catchtap="retryUpload">
        <view class="upload-status">{{item.statusText}}</view>
        <view class="failure-reason">{{item.error}}</view>
      </view>
    </view>
  </view>
  <view class="upload-summary" wx:if="{{uploading}}">图片正在上传，请勿重复点击或离开页面</view>
</view>
