.image-manager { width: 100%; }
.image-manager-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.image-manager-title { font-size: 24rpx; color: #475569; }
.image-count { font-size: 22rpx; color: #64748b; }
.image-add { display: flex; align-items: center; gap: 18rpx; box-sizing: border-box; width: 100%; padding: 24rpx; border: 2rpx dashed #cbd5e1; border-radius: 20rpx; background: #f8fafc; }
.image-add-disabled { opacity: .55; }
.image-add-plus { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 27rpx; background: #14213d; color: #fff; font-size: 38rpx; line-height: 1; }
.image-add-title { color: #14213d; font-size: 27rpx; font-weight: 700; }
.image-add-tip { margin-top: 6rpx; color: #94a3b8; font-size: 20rpx; }
.loading-tip, .error-tip, .upload-summary { margin-top: 14rpx; font-size: 22rpx; line-height: 1.5; }
.loading-tip, .upload-summary { color: #64748b; }
.error-tip { color: #dc2626; }
.thumb-list { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 18rpx; }
.thumb-item { position: relative; width: 146rpx; height: 146rpx; overflow: hidden; border-radius: 18rpx; background: #e2e8f0; }
.thumb-image { width: 100%; height: 100%; }
.thumb-remove { position: absolute; z-index: 3; top: 8rpx; right: 8rpx; display: flex; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; border-radius: 18rpx; background: rgba(15, 23, 42, .76); color: #fff; font-size: 28rpx; }
.upload-mask { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 14rpx; box-sizing: border-box; background: rgba(15, 23, 42, .68); color: #fff; }
.upload-failed { background: rgba(127, 29, 29, .82); }
.upload-status { font-size: 20rpx; text-align: center; }
.failure-reason { overflow: hidden; max-width: 100%; margin-top: 6rpx; color: #fee2e2; font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }
.progress-track { width: 100%; height: 8rpx; margin-top: 12rpx; overflow: hidden; border-radius: 999rpx; background: rgba(255,255,255,.28); }
.progress-value { height: 100%; border-radius: inherit; background: #60a5fa; transition: width .2s; }
